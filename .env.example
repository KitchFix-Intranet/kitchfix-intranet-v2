# The complete environment for kitchfix-intranet-v2. Names only; values are set
# in Vercel and in .env.local for development. Any variable not on this list
# is a blocker, not a thing to add.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAILS=
CRON_SECRET=

# Step 5 (AI matcher): Claude Messages API key. Optional for every surface
# except /api/match + `npm run match`; the matcher refuses to run without it
# (so no silent "did nothing" state). Added in commit 1 of step 5; no code
# imports it directly - src/lib/anthropic.ts reads it from process.env.
ANTHROPIC_API_KEY=
# Optional override; defaults to a stable Sonnet in src/lib/anthropic.ts.
ANTHROPIC_MODEL=
